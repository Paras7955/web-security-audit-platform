# ScopeHarbor 1.1 local environment reference.
# Run `./scripts/setup.sh` (macOS/Linux) or `scripts/setup.ps1` (Windows) to
# create or merge `.env` inside an isolated, digest-pinned Docker container.
# Secrets are intentionally blank. The bootstrap generates local values without
# replacing a non-empty AUTH_PROFILE_SECRET_KEY.
POSTGRES_DB=security_audit
POSTGRES_USER=security_audit
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=3001
JUICE_SHOP_PORT=3000
DATABASE_URL=

# Application storage and trusted operator configuration
ARTIFACT_ROOT=/app/artifacts
REPO_SCAN_ROOT=/app/repositories
REPO_STAGING_ROOT=/tmp/scopeharbor-repo-staging
ALLOWLIST_PATH=/app/config/scan-allowlist.yml
GITLEAKS_CONFIG_PATH=/app/config/gitleaks.toml
OSV_CONFIG_PATH=/app/config/osv-scanner.toml
OSV_DATABASE_PATH=/var/lib/osv-scanner
OSV_DATABASE_MAX_AGE_DAYS=7

# Authentication. Dev auth is local-only; non-local environments require OIDC.
APP_ENV=local
AUTH_MODE=dev
AUTH_PROVIDER=dev
DEV_AUTH_TOKEN=
DEV_AUTH_USER_ID=dev-user
DEV_AUTH_WORKSPACE_ID=dev-workspace
DEV_AUTH_SUBJECT=dev-user
AUTH_PROFILE_SECRET_KEY=
AUTH_PROFILE_PREVIOUS_SECRET_KEY=
AUTH_OIDC_ISSUER=
AUTH_OIDC_AUDIENCE=
AUTH_OIDC_JWKS_URL=

# AI. The template provider is local and deterministic.
AI_PROVIDER=template
AI_RATE_LIMIT_WINDOW_SECONDS=3600
AI_RATE_LIMIT_MAX_REQUESTS=20
AI_CACHE_ENABLED=true
AI_MAX_FINDINGS=100
AI_MAX_PAYLOAD_BYTES=131072
OPENAI_MODEL=
OPENAI_API_KEY=

# API and pagination limits
API_RATE_LIMIT_WINDOW_SECONDS=3600
SCAN_CREATE_RATE_LIMIT_MAX_REQUESTS=1000
REPORT_GENERATION_RATE_LIMIT_MAX_REQUESTS=200
MAX_REQUEST_BODY_BYTES=1048576
PAGE_DEFAULT_LIMIT=50
PAGE_MAX_LIMIT=200

# Worker, repository scanner, and ZAP limits
HEALTH_ZAP_TIMEOUT_SECONDS=1.5
WORKER_ID=default-worker
WORKER_STALE_AFTER_SECONDS=30
WORKER_LEASE_SECONDS=45
REPO_MAX_FILES=20000
REPO_MAX_FILE_BYTES=20971520
REPO_MAX_TOTAL_BYTES=536870912
REPO_TOOL_TIMEOUT_SECONDS=120
REPO_TOOL_OUTPUT_BYTES=10485760
REPO_TOOL_MAX_FINDINGS=1000
GITLEAKS_BINARY=gitleaks
OSV_SCANNER_BINARY=osv-scanner
ZAP_BASE_URL=http://zap:8080
ZAP_API_KEY=

# Guarded local-target relay. Bootstrap generates the shared capability secret.
SCAN_RELAY_URL=http://relay:8090
SCAN_RELAY_SECRET=
SCAN_RELAY_REQUEST_TIMEOUT_SECONDS=10
SCAN_RELAY_BODY_BYTES=65536

# Demo seed is always explicit and performs no network work.
DEMO_SEED_ENABLED=false

# Browser/API boundaries
CORS_ORIGINS=["http://localhost:3001"]
TRUSTED_HOSTS=["localhost","127.0.0.1","testserver","backend"]
TRUSTED_PROXY_IPS=[]

# Frontend build-time values retained for the current UI.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_DEV_AUTH_TOKEN=
