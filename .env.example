POSTGRES_DB=security_audit
POSTGRES_USER=security_audit
POSTGRES_PASSWORD=security_audit
DATABASE_URL=postgresql+psycopg://security_audit:security_audit@postgres:5432/security_audit
ARTIFACT_ROOT=/app/artifacts
REPO_SCAN_ROOT=/app/repositories
APP_ENV=local
AUTH_MODE=dev
AUTH_PROVIDER=dev
DEV_AUTH_TOKEN=dev-token
DEV_AUTH_USER_ID=dev-user
DEV_AUTH_WORKSPACE_ID=dev-workspace
DEV_AUTH_SUBJECT=dev-user
AUTH_PROFILE_SECRET_KEY=replace-with-a-generated-fernet-key
AUTH_OIDC_ISSUER=
AUTH_OIDC_AUDIENCE=
AUTH_OIDC_JWKS_URL=
AI_PROVIDER=template
AI_RATE_LIMIT_WINDOW_SECONDS=3600
AI_RATE_LIMIT_MAX_REQUESTS=20
AI_CACHE_ENABLED=true
API_RATE_LIMIT_WINDOW_SECONDS=3600
SCAN_CREATE_RATE_LIMIT_MAX_REQUESTS=1000
REPORT_GENERATION_RATE_LIMIT_MAX_REQUESTS=200
HEALTH_ZAP_TIMEOUT_SECONDS=1.5
WORKER_ID=default-worker
WORKER_STALE_AFTER_SECONDS=30
DEMO_SEED_ENABLED=false
OPENAI_MODEL=
OPENAI_API_KEY=
ZAP_BASE_URL=http://zap:8080
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
