# Run `python3 scripts/bootstrap_env.py` to create or complete `.env`.
POSTGRES_DB=security_audit
POSTGRES_USER=security_audit
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=3001
JUICE_SHOP_PORT=3000
DATABASE_URL=postgresql+psycopg://security_audit:security_audit@postgres:5432/security_audit
ARTIFACT_ROOT=/app/artifacts
REPO_SCAN_ROOT=/app/repositories
REPO_STAGING_ROOT=/tmp/scopeharbor-repo-staging
ALLOWLIST_PATH=/app/config/scan-allowlist.yml
GITLEAKS_CONFIG_PATH=/app/config/gitleaks.toml
OSV_CONFIG_PATH=/app/config/osv-scanner.toml
OSV_DATABASE_PATH=/var/lib/osv-scanner
APP_ENV=local
AUTH_MODE=dev
AUTH_PROVIDER=dev
DEV_AUTH_TOKEN=
DEV_AUTH_USER_ID=dev-user
DEV_AUTH_WORKSPACE_ID=dev-workspace
DEV_AUTH_SUBJECT=dev-user
AUTH_PROFILE_SECRET_KEY=
AUTH_PROFILE_PREVIOUS_SECRET_KEY=
AUTH_OIDC_ISSUER=
AUTH_OIDC_AUDIENCE=
AUTH_OIDC_JWKS_URL=
AI_PROVIDER=template
AI_RATE_LIMIT_WINDOW_SECONDS=3600
AI_RATE_LIMIT_MAX_REQUESTS=20
AI_CACHE_ENABLED=true
API_RATE_LIMIT_WINDOW_SECONDS=3600
SCAN_CREATE_RATE_LIMIT_MAX_REQUESTS=1000
REPORT_GENERATION_RATE_LIMIT_MAX_REQUESTS=200
HEALTH_ZAP_TIMEOUT_SECONDS=1.5
WORKER_ID=default-worker
WORKER_STALE_AFTER_SECONDS=30
WORKER_LEASE_SECONDS=45
DEMO_SEED_ENABLED=false
OPENAI_MODEL=
OPENAI_API_KEY=
ZAP_BASE_URL=http://zap:8080
ZAP_API_KEY=
CORS_ORIGINS=["http://localhost:3001"]
TRUSTED_HOSTS=["localhost","127.0.0.1","testserver","backend"]
TRUSTED_PROXY_IPS=[]
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_DEV_AUTH_TOKEN=
